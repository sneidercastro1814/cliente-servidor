<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  Prueba Tecnica Carvajal - Desarrollador Full Stack Expert
  Modulo: wishlist-service (API REST - Lista de Deseos)

  Stack:
    - Java 21 (LTS)
    - Spring Boot 4.0.x  (Spring Boot 3.5 salio de soporte OSS el 30-jun-2026)
    - Spring Data JPA + Hibernate  -> capa de persistencia ORM
    - MySQL 8                      -> base de datos relacional propuesta
    - Flyway                       -> scripts versionados de creacion de BD
    - Spring Security + JWT        -> plus de autenticacion
    - springdoc-openapi v3         -> la v3 es la compatible con Spring Boot 4
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.carvajal</groupId>
    <artifactId>wishlist-service</artifactId>
    <version>1.0.0</version>
    <name>wishlist-service</name>
    <description>API REST de Lista de Deseos - Prueba Tecnica Carvajal</description>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>3.0.3</springdoc.version>
    </properties>

    <dependencies>

        <!-- ================= API REST ================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ========= Capa de persistencia: ORM ======== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ====== Validacion declarativa de DTOs ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          Actuator: expone /actuator/health, que es lo que usa el healthcheck
          de docker-compose para saber cuando la API ya quedo arriba.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ============ Seguridad + JWT ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
          Usamos el soporte JWT nativo de Spring Security (Nimbus) en lugar de
          una libreria externa como jjwt: menos dependencias, sin riesgo de
          choque con Jackson 3 (que es el que trae Spring Boot 4).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ================= MySQL =================== -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ====== Migraciones versionadas de BD ====== -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ========= Documentacion OpenAPI ========== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ================= Pruebas ================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- H2 en modo MySQL para las pruebas de integracion (no requiere Docker) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
